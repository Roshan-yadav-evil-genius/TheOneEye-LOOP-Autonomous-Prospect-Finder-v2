LOOP_ENV=development
LOOP_API_HOST=127.0.0.1
LOOP_API_PORT=7878
LOOP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Main OLTP persistence (SQLite; relative paths resolve from backend/)
LOOP_DATABASE_URL=sqlite:///instance/loop.db
# Local E2E dummy data: from backend/, run `loop seed` (recreates SQLite tables + seed)
# or `python -m cli seed`. Skip if already seeded: `loop seed --no-wipe`.
# Seeds SQLite OLTP only (not PostgreSQL threads).

# LangChain/LangGraph effort threads and checkpoints (PostgreSQL only)
LOOP_THREADS_ENABLED=false
LOOP_THREADS_DATABASE_URL=postgresql://loop:loop@127.0.0.1:5432/loop_threads

LOOP_REDIS_URL=redis://127.0.0.1:6379/0
LOOP_MODEL_PROVIDER=deterministic
LOOP_MODEL_NAME=deterministic
LOOP_MODEL_BASE_URL=
LOOP_MODEL_API_KEY=
LOOP_BROWSER_MCP_URL=http://127.0.0.1:8931/mcp
LOOP_BROWSER_ALLOWED_DOMAINS=linkedin.com,google.com,crunchbase.com,producthunt.com,ycombinator.com,wellfound.com,github.com
LOOP_BROWSER_ACTION_INTERVAL_SECONDS=2
LOOP_AGENT_PACING_SECONDS=300
LOOP_MAX_JOB_ATTEMPTS=5
LOOP_JOB_RETRY_BASE_SECONDS=2
LOOP_BUILD_VERSION=0.1.0
LOOP_COMMIT_SHA=local
LOOP_BUILD_TIMESTAMP=unknown
